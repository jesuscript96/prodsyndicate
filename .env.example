# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.

# URL pública del sitio (sin barra final). En local: http://localhost:3200. En producción se usa https://www.automatoagency.art si no se define.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (antispam del formulario). Sin clave, el widget no se carga
# y el servidor omite la verificación (solo aceptable en desarrollo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Valme OS: CRM de los leads y correo de respuesta con el resumen en PDF (lib/valme-os.ts).
# JSON con el id de cada landing de Valme OS: {"tiempo":"…","procesos":"…","crecer":"…","web":"…"}.
# tiempo/procesos/crecer = landings /encaja/*; web = formulario de /contacto. SOLO servidor.
VALME_OS_LANDINGS=
# Opcional: por defecto https://www.valmesolutions.com/api/leads
VALME_OS_LEADS_URL=

# Supabase (tabla public.leads, ver supabase/schema.sql). Opcional si Valme OS está configurado. SOLO servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aviso por correo de cada lead: reserva, «te escribimos nosotros» y /contacto (lib/notify.ts).
# Clave de Resend con permiso de envío desde automatoagency.art (dominio verificado). SOLO servidor.
RESEND_API_KEY=
# Destinatarios del aviso, separados por comas. «Responder» va directo al cliente.
CONTACT_TO_EMAIL=hola@automatoagency.art
CONTACT_FROM_EMAIL="AUTOMATO · Avisos <avisos@automatoagency.art>"

# Analítica sin cookies (Plausible/Umami), opcional
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Agenda de la web con Google Calendar y Google Meet (docs/agenda-google.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opcional: calendario donde se crean las llamadas (por defecto, el principal) y otros que cuentan como ocupado
GOOGLE_CALENDAR_ID=
GOOGLE_BUSY_CALENDARS=

# Asistente con IA de las landings de Encaja (docs/encaja/asistente.md). SOLO servidor.
# Sin DEEPSEEK_API_KEY y ASSISTANT_SECRET el asistente no aparece en producción; en local responde en modo de prueba.
DEEPSEEK_API_KEY=
# Secreto aleatorio para firmar las sesiones del chat (openssl rand -base64 32)
ASSISTANT_SECRET=
# Opcional: modelo de DeepSeek (por defecto deepseek-flash)
DEEPSEEK_MODEL=
